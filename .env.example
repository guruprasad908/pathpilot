# ─── PathPilot Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in all values before running the app.
# NEVER commit .env.local to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: A secure, random secret for signing JWT session tokens.
# Generate one with: openssl rand -base64 32
# WARNING: If this is missing, the server will refuse to start.
NEXTAUTH_SECRET=

# The canonical URL of your app (used for absolute links in emails, etc.)
NEXTAUTH_URL=http://localhost:3000

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# REQUIRED: Your OpenAI API key for the AI roadmap generation endpoint.
# Get yours from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── App Environment ──────────────────────────────────────────────────────────
# Set to "production" when deploying. Controls secure cookie flags.
NODE_ENV=development
